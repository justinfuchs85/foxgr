{
  "name": "foxgr-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "seed": "NODE_OPTIONS=--no-deprecation payload run seed/seed.ts",
    "generate:importmap": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "tsc --noEmit",
    "migrate": "NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "NODE_OPTIONS=--no-deprecation payload migrate:create",
    "deploy": "NODE_OPTIONS=--no-deprecation payload migrate && NODE_OPTIONS=--no-deprecation payload run seed/seed.ts && pnpm build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "4.0.0-beta.4",
    "@payloadcms/live-preview-react": "4.0.0-beta.4",
    "@payloadcms/next": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/storage-s3": "4.0.0-beta.4",
    "@payloadcms/transformer-sharp": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "file-type": "22.0.1",
    "graphql": "^16.8.1",
    "lenis": "^1.3.27",
    "next": "16.4.2",
    "payload": "4.0.0-beta.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
