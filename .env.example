# Supabase Postgres — use the pooled connection string (Settings → Database → Connection string → Transaction pooler)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Any long random string. `openssl rand -hex 32`
PAYLOAD_SECRET=

# Public URL of the site (used for live preview + metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage (S3-compatible) for media uploads. Leave blank to store uploads on local disk (dev only).
# Settings → Storage → S3 Connection
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Google Analytics 4 measurement ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
